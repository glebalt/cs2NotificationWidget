<Window x:Class="WpfApp2.Models.ApplicationStartupNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2.Models"
        mc:Ignorable="d"
        Title="Notification" Height="60" Width="200"
        Topmost ="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" RenderTransformOrigin ="0.5,0.5">

    <Window.Resources>
        <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.1" Color="#e62222"/>
            <GradientStop Offset="0.9" Color="#393b3a"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="RedGradv2" MappingMode="Absolute" RadiusX="1000" RadiusY="600" Center="100,-100"  GradientOrigin="100,-55"  >
            <GradientStop Color="#1a1a1a" Offset="0.2"/>
            <GradientStop Color="#a39605"/>
        </RadialGradientBrush>

        
    </Window.Resources>

  
    <Grid>

        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.2" ScaleY="0.2"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" x:Name="_Border" Background="{StaticResource RedGradv2}" CornerRadius="20"/>
        <TextBlock Text="Freezetime Started" Foreground="#dedcdc" Grid.RowSpan="2" Grid.ColumnSpan ="2" HorizontalAlignment="Center" Margin="0 40 0 0" FontFamily="Consolas"/>
        <Rectangle Grid.Row="1" Grid.ColumnSpan="2"  x:Name="_Rectangle" Width="200" Height="1" Fill="LightGoldenrodYellow" Margin="0 -90 0 0" RadiusX="5" RadiusY="5"  />
       
    </Grid>
</Window>
